@model Tabletopgenerator.Models.ViewModel.SettingsCharacterViewModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>Character Generator</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet" />
    <link href="~/css/CharacterGenerator.css" rel="stylesheet" />
</head>
<body>

    <div class="main-container">
        <h1 class="mb-4 fw-bold">✨ Character Generator ✨</h1>

        <form asp-action="Character" asp-controller="Generator" method="post" class="row g-3 justify-content-center">

            <!-- Race -->
            <div class="col-12">
                <label class="form-label fw-bold d-block">Choose a Race</label>
                <div class="slider-container">
                    <div class="slider" id="raceSlider">
                        @foreach (var race in Model.Races)
                        {
                            <div class="option race-option" data-id="@race.Id">
                                <div class="circle"></div>
                                <span>@race.Name</span>
                            </div>
                        }
                    </div>
                </div>
                <input type="hidden" asp-for="Criterea.Race.Id" id="selectedRace" />
            </div>

            <!-- Setting -->
            <div class="col-12">
                <label class="form-label fw-bold d-block">Choose a Setting</label>
                <div class="slider-container">
                    <div class="slider" id="settingSlider">
                        @foreach (var setting in Model.SettingTypes)
                        {
                            <div class="option setting-option" data-id="@setting.Id">
                                <div class="circle"></div>
                                <span>@setting.Type</span>
                            </div>
                        }
                    </div>
                </div>
                <input type="hidden" asp-for="Criterea.Setting.Id" id="selectedSetting" />
            </div>

            <!-- Trait -->
            <div class="col-12 col-md-6">
                <label asp-for="Criterea.CustomTrait" class="form-label fw-bold">Trait</label>
                <input asp-for="Criterea.CustomTrait"
                       class="form-control text-center"
                       placeholder="E.g. Pirate, Scholar, Assassin..." />
            </div>


            <div class="col-md-6 col-12 mb-3">
                <label asp-for="Criterea.Amount" class="form-label fw-bold">Amount</label>
                <div class="btn-group w-100 mb-2" role="group">
                    <input type="radio" class="btn-check" name="amountPreset" id="amount1" autocomplete="off" checked>
                    <label class="btn btn-outline-primary" for="amount1" onclick="setAmount(1)">1</label>

                    <input type="radio" class="btn-check" name="amountPreset" id="amount5" autocomplete="off">
                    <label class="btn btn-outline-primary" for="amount5" onclick="setAmount(5)">5</label>

                    <input type="radio" class="btn-check" name="amountPreset" id="amount10" autocomplete="off">
                    <label class="btn btn-outline-primary" for="amount10" onclick="setAmount(10)">10</label>

                    <input type="radio" class="btn-check" name="amountPreset" id="amountCustom" autocomplete="off">
                    <label class="btn btn-outline-primary" for="amountCustom" onclick="focusCustom()">Custom ✍️</label>
                </div>

                <input asp-for="Criterea.Amount" id="amountInput" type="number" min="1" value="1" class="form-control text-center" />
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-success btn-lg mt-3">Generate Character</button>
            </div>
        </form>

        <div class="result-box mt-5 p-4 bg-white rounded shadow-sm text-center">
            <h3>Generated Character:</h3>

            @if (Model?.GeneratedCharacter != null && Model.GeneratedCharacter.FirstName.Any())
            {
                <ul class="character-list list-unstyled row g-3 justify-content-center">
                    @for (int i = 0; i < Model.GeneratedCharacter.FirstName.Count && i < Model.GeneratedCharacter.LastName.Count; i++)
                    {
                        <li class="col-12 col-sm-6 col-lg-4 bg-light p-3 rounded">
                            <span class="character-name fw-semibold">
                                @Model.GeneratedCharacter.FirstName[i].Name @Model.GeneratedCharacter.LastName[i].Name
                            </span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p><em>Your character info will appear here...</em></p>
            }
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function setAmount(val) {
            const input = document.getElementById('amountInput');
            input.value = val;
        }

        function focusCustom() {
            document.getElementById('amountInput').focus();
            document.getElementById('amountInput').select();
        }
    </script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const selectors = [
                { slider: "raceSlider", input: "selectedRace", optionClass: "race-option" },
                { slider: "settingSlider", input: "selectedSetting", optionClass: "setting-option" },
                { slider: "traitSlider", input: "selectedTrait", optionClass: "trait-option" }
            ];

            selectors.forEach(sel => {
                const slider = document.getElementById(sel.slider);
                const options = slider.querySelectorAll(`.${sel.optionClass}`);
                const input = document.getElementById(sel.input);

                options.forEach(option => {
                    option.addEventListener("click", () => {
                        options.forEach(o => o.classList.remove("selected"));
                        option.classList.add("selected");
                        input.value = option.getAttribute("data-id");
                    });
                });

                // Drag-to-scroll
                let isDown = false;
                let startX;
                let scrollLeft;

                slider.addEventListener("mousedown", (e) => {
                    isDown = true;
                    startX = e.pageX - slider.offsetLeft;
                    scrollLeft = slider.scrollLeft;
                });
                slider.addEventListener("mouseleave", () => isDown = false);
                slider.addEventListener("mouseup", () => isDown = false);
                slider.addEventListener("mousemove", (e) => {
                    if (!isDown) return;
                    e.preventDefault();
                    const x = e.pageX - slider.offsetLeft;
                    const walk = (x - startX) * 2;
                    slider.scrollLeft = scrollLeft - walk;
                });
            });
        });
    </script>

</body>
</html>
