<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Tabletop Generator</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">
    <style>
        body {
            margin: 0;
            font-family: 'Inter', sans-serif;
            background: #f8f9fa;
            color: #212529;
            transition: all 0.3s;
        }

        .main {
            margin-left: 240px;
            padding: 2rem;
            transition: margin-left 0.3s ease;
        }

        .auth-buttons {
            display: flex;
            gap: 1rem;
        }

        .login-button,
        .upgrade-button {
            padding: 0.5rem 1rem;
            border: none;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
        }

        .login-button {
            background: #dee2e6;
            color: #212529;
        }

        .upgrade-button {
            background: #00b894;
            color: white;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
            margin-top: 2rem;
        }

        .card {
            background: white;
            border-radius: 12px;
            padding: 1rem 1.2rem;
            box-shadow: 0 2px 6px rgba(0,0,0,0.05);
            transition: 0.2s ease-in-out;
        }

        .card h3 {
            font-size: 1rem;
            margin: 0 0 0.5rem 0;
        }

        .card p {
            font-size: 0.875rem;
            color: #6c757d;
        }

        .card.active:hover {
            transform: translateY(-3px);
            cursor: pointer;
        }

        .card.disabled {
            opacity: 0.5;
            pointer-events: none;
        }

    </style>
</head>
<body>
    <div class="main" id="main">
        <div class="header">
            @* <button class="toggle-button" onclick="toggleSidebar()">☰</button> *@
            <div class="auth-buttons">
                <ul class="navbar-nav mb-2 mb-lg-0">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle me-1"></i>
                                Hello, @User.Identity.Name
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                <li>
                                    <a class="dropdown-item" href="@Url.Action("Profile", "Account")">
                                        <i class="bi bi-person-lines-fill me-2"></i> Profile
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form method="post" asp-controller="Account" asp-action="Logout" class="px-3 py-1">
                                        <button type="submit" class="btn btn-link text-decoration-none w-100 text-start">
                                            <i class="bi bi-box-arrow-right me-2"></i> Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Login", "Account")">Login</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Register", "Account")">Register</a></li>
                    }
                </ul>
                <button class="login-button">Login</button>
                <button class="upgrade-button">Upgrade</button>
            </div>
        </div>

        <div class="grid">
            <div class="card active">
                <h3>Race Name Generator</h3>
                <p>Fantasy-themed race names with cultural flavor</p>
            </div>
            <div class="card disabled">
                <h3>City Name Generator</h3>
                <p>Generate immersive city names for your world</p>
            </div>
            <div class="card disabled">
                <h3>Religion Generator</h3>
                <p>Random pantheons and beliefs for worldbuilding</p>
            </div>
            <div class="card disabled">
                <h3>Blacksmith Generator</h3>
                <p>Give your towns blacksmiths a little flavor</p>
            </div>
        </div>
    </div>

    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById("sidebar");
            sidebar.classList.toggle("collapsed");
        }
    </script>
</body>
</html>
